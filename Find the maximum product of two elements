int[] arr = { 10, 3, 5, 6, 2 };

int maxProduct = int.MinValue;

for (int i = 0; i < arr.Length; i++)
{
    for (int j = i + 1; j < arr.Length; j++)
    {
        int product = arr[i] * arr[j];

        if (product > maxProduct)
            maxProduct = product;
    }
}

Console.WriteLine(maxProduct);
