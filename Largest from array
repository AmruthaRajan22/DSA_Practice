using System;

public class HelloWorld {
    public static void Main(string[] args) {

      int[] arr = {12, 45, 7, 89, 23};
      int largest= arr[0];

        for(int i=0;i< arr.Length;i++)
        {
          if(arr[i]>largest)
          {
              largest=arr[i];
          }
        }
      Console.WriteLine("This is the largest num "+ largest);
    }
}
