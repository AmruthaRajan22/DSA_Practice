int[,] arr =
{
    { 1, 0, 0 },
    { 0, 1, 0 },
    { 0, 0, 1 }
};

bool identity = true;

for (int i = 0; i < 3; i++)
{
    for (int j = 0; j < 3; j++)
    {
        if (i == j && arr[i, j] != 1)
            identity = false;

        if (i != j && arr[i, j] != 0)
            identity = false;
    }
}

Console.WriteLine(identity);
