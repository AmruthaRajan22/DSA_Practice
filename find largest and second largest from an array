using System;

public class HelloWorld {
    public static void Main(string[] args) {

        int []num= {10, 25, 8, 40, 30};
        int max=num[0];
        int secmax=num[0];

            for(int i=0;i<num.Length;i++)
            {
                if(num[i]>=max)
                {
                    secmax=max;
                    max=num[i];
