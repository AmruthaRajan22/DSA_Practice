using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter array size: ");
        int n = int.Parse(Console.ReadLine());

        int[] arr = new int[n];

        Console.WriteLine("Enter array elements:");

        for (int i = 0; i < n; i++)
            arr[i] = int.Parse(Console.ReadLine());

        Console.WriteLine("Array without duplicates:");

        for (int i = 0; i < n; i++)
        {
            bool duplicate = false;

            for (int j = 0; j < i; j++)
            {
                if (arr[i] == arr[j])
                {
                    duplicate = true;
                    break;
                }
            }

            if (!duplicate)
                Console.Write(arr[i] + " ");
        }
    }
}
