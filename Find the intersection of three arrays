int[] a = { 1, 5, 10, 20 };
int[] b = { 5, 10, 15, 20 };
int[] c = { 5, 10, 20, 25 };

foreach (int x in a)
{
    bool foundB = false;
    bool foundC = false;

    foreach (int y in b)
    {
        if (x == y)
            foundB = true;
    }

    foreach (int z in c)
    {
        if (x == z)
            foundC = true;
    }

    if (foundB && foundC)
        Console.WriteLine(x);
}
