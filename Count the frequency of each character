using System;

class Program
{
    static void Main()
    {
        Console.Write("Enter a string: ");
        string str = Console.ReadLine().ToLower();

        bool[] visited = new bool[str.Length];

        for (int i = 0; i < str.Length; i++)
        {
            if (visited[i])
                continue;

            int count = 1;

            for (int j = i + 1; j < str.Length; j++)
            {
                if (str[i] == str[j])
                {
                    count++;
                    visited[j] = true;
                }
            }

            Console.WriteLine(str[i] + " = " + count);
        }
    }
}
