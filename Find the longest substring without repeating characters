string s = "abcabcbb";
int max = 0;

for (int i = 0; i < s.Length; i++)
{
    string temp = "";

    for (int j = i; j < s.Length; j++)
    {
        if (temp.Contains(s[j]))
            break;

        temp += s[j];

        if (temp.Length > max)
            max = temp.Length;
    }
}

Console.WriteLine(max);
