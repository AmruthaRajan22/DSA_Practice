using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Enter a decimal number:");
        int num = Convert.ToInt32(Console.ReadLine());

        string binary = "";

        while (num > 0)
        {
            int remainder = num % 2;

            binary = remainder + binary;

            num = num / 2;
        }

        Console.WriteLine("Binary: " + binary);
    }
}